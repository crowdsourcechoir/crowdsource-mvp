{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "crowdsource-mvp.vercel.app" }],
      "destination": "https://app.crowdsourcechoir.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/sales/cron/discovery",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/sales/cron/pipeline",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/sales/cron/digest",
      "schedule": "0 10 * * *"
    }
  ]
}
