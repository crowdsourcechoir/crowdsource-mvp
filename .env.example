# Optional: for AI transcription and summary script on the event manage page.
# Get a key at https://platform.openai.com/api-keys
# For production (e.g. Vercel): add OPENAI_API_KEY in Project → Settings → Environment Variables.
OPENAI_API_KEY=

# Password required to view the root page (/). If unset, the root page is not gated.
ROOT_PAGE_PASSWORD=

# Local testing: set to "true" to save events in memory so you can test without Supabase (create/edit/list events).
# Agent Interview (Let's Chat) still requires Supabase. Set to "false" or leave unset to use Supabase for events.
# PRODUCTION: do not set USE_LOCAL_EVENTS, or set to "false".
USE_LOCAL_EVENTS=

# Supabase (required for events to be saved and available everywhere, and for Agent Interview).
# Create a project at https://supabase.com, then run supabase/events-table.sql in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (required for in-chat email captcha when Email+Captcha is enabled on a question).
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Add localhost and your production domain to the widget's allowed hostnames.
# Verify locally: http://localhost:3000/api/turnstile/status
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Google Maps Embed API key for event address previews (enable "Maps Embed API" in Google Cloud).
# Without it, a basic Google Maps embed still works in the admin form.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Optional storage bucket name for uploaded interview audio/video clips.
SUPABASE_MEDIA_BUCKET=agent-media
