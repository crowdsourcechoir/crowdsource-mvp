# Optional: for AI transcription and summary script on the event manage page.
# Get a key at https://platform.openai.com/api-keys
# For production (e.g. Vercel): add OPENAI_API_KEY in Project → Settings → Environment Variables.
OPENAI_API_KEY=

# Password required to view the root page (/). If unset, the root page is not gated.
ROOT_PAGE_PASSWORD=

# Local testing: set to "true" to save events in memory so you can test without Supabase (create/edit/list events).
# Agent Interview (Let's Chat) still requires Supabase. Set to "false" or leave unset to use Supabase for events.
# PRODUCTION: do not set USE_LOCAL_EVENTS, or set to "false".
USE_LOCAL_EVENTS=

# Supabase (required for events to be saved and available everywhere, and for Agent Interview).
# Create a project at https://supabase.com, then run supabase/events-table.sql in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (required for in-chat email captcha when Email+Captcha is enabled on a question).
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Add localhost and your production domain to the widget's allowed hostnames.
# Verify locally: http://localhost:3000/api/turnstile/status
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Google Maps Embed API key for event address previews (enable "Maps Embed API" in Google Cloud).
# Without it, a basic Google Maps embed still works in the admin form.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Optional storage bucket name for uploaded interview audio/video clips.
SUPABASE_MEDIA_BUCKET=agent-media

# Sales platform (docs/sales-platform/). Requires OPENAI_API_KEY and Supabase above, plus
# running supabase/sales-platform-tables.sql and supabase/sales-platform-rls.sql once in the
# Supabase SQL Editor.
# Optional: display name used as {{sender_name}} in outreach drafts. Defaults to "Joel DeJong".
SALES_SENDER_NAME=
# Optional (Phase 2): contact email enrichment for named people found on an org's own site who
# don't have a listed email. Also requires supabase/sales-platform-add-contact-enrichment.sql
# to be run once in the Supabase SQL Editor. Apollo is tried first if set, and the code
# automatically retries with Hunter if Apollo's call errors out and a Hunter key is also
# present. Leave both unset to skip enrichment entirely (default; no cost).
# IMPORTANT: confirmed live that Apollo's enrichment endpoint requires a PAID Apollo plan — a
# free-plan key gets a 403 on every call. If you only have a free Apollo account, you MUST also
# set HUNTER_API_KEY below for enrichment to actually do anything (the runtime fallback covers
# you). Hunter's Email Finder is genuinely usable on Hunter's free plan (50 credits/month).
# Apollo (needs a paid plan to work): create a key at https://app.apollo.io -> Settings -> Integrations -> API.
APOLLO_API_KEY=
# Hunter (works on the free plan): create a key at https://hunter.io/api-keys.
HUNTER_API_KEY=
# Optional (Stage 0): nightly/manual discovery of brand-new candidate organizations not yet in
# your list — see docs/sales-platform/ai-workflow.md "Stage 0" and lib/sales/discovery. Also
# requires supabase/sales-platform-add-discovery.sql to be run once in the Supabase SQL Editor.
# Tavily is tried first if both are set; Serper is the automatic fallback if only it is set.
# Both have self-serve free-tier API keys — no sales call needed. Leave both unset to skip
# discovery entirely (default; no cost) — the "Run discovery now" button in
# /admin/sales/organizations will just report a no-op.
# Tavily: create a key at https://app.tavily.com (free tier, no card required).
TAVILY_API_KEY=
# Serper: create a key at https://serper.dev/api-key (free tier, no card required).
SERPER_API_KEY=
# Optional discovery volume knobs (defaults shown). Raise once long-tail queries yield new orgs.
# SALES_DISCOVERY_MAX_QUERIES=8
# SALES_DISCOVERY_MAX_NEW_ORGS=20
# SALES_DISCOVERY_MAX_RESULTS=12
# SALES_DISCOVERY_EXCLUDE_DOMAINS=40

# Required to enable the nightly Vercel Cron jobs (discovery, pipeline processing, digest — see
# vercel.json + app/api/sales/cron/*/route.ts). Vercel sends this value automatically as an
# `Authorization: Bearer <value>` header on scheduled cron invocations once this is set as a
# Vercel Project env var — generate any long random string (e.g. `openssl rand -hex 32`).
# Without it, every cron route refuses every request (including Vercel's own), and you can still
# trigger each one manually via the admin UI/API in the meantime.
CRON_SECRET=

# Optional: how many unprocessed organizations the nightly pipeline-processing cron
# (/api/sales/cron/pipeline) attempts per run. Defaults to 15. Actual throughput per run is also
# capped by SALES_PIPELINE_CRON_TIME_BUDGET_MS below and by your Vercel plan's function execution
# limit — see docs/sales-platform/architecture.md §6.
SALES_PIPELINE_BATCH_SIZE=
# Optional: soft time budget (ms) the pipeline-processing cron gives itself before stopping and
# leaving the rest for the next run. Defaults to 240000 (4 minutes). Keep this comfortably under
# your Vercel plan's actual function execution limit.
SALES_PIPELINE_CRON_TIME_BUDGET_MS=

# Morning digest email — "new leads in my inbox every morning." Runs via cron
# (/api/sales/cron/digest) after discovery + pipeline processing, see roadmap.md. Requires
# running supabase/sales-platform-add-digest.sql once in the Supabase SQL Editor, and
# supabase/sales-platform-add-digest-item-tracking.sql so force-sends don't silence the week.
# Resend: create a key at https://resend.com/api-keys (free tier, no card required).
# NOTE: Resend is only for this internal digest — 1:1 prospect outreach uses Gmail (below).
RESEND_API_KEY=
# Optional override for digest recipient. Defaults in code to sing@crowdsourcechoir.com.
# (The retired crowdsourcechoir@gmail.com value is ignored if still set in an old deploy env.)
SALES_DIGEST_TO_EMAIL=sing@crowdsourcechoir.com
# Optional: the "from" address. Defaults to Resend's shared testing address
# ("onboarding@resend.dev"), which works immediately but looks less official; verify your own
# domain in Resend and set e.g. "Crowdsource Sales <sales@yourdomain.com>" once you want that.
SALES_DIGEST_FROM_EMAIL=
# Only include queue items scoring at least this many points (default 70). Cron will keep
# topping up discovery/pipeline and hold the email until SALES_DIGEST_TARGET_COUNT such leads
# are ready since the last successful send (no schema change required for the hold).
SALES_DIGEST_MIN_SCORE=70
# How many min-score leads to wait for before the cron actually sends (default 10).
SALES_DIGEST_TARGET_COUNT=10
# Optional: soft time budget (ms) each digest cron invocation spends topping up before
# sending or holding. Defaults to 240000 (4 minutes). Keep under the route's maxDuration.
SALES_DIGEST_TOPUP_TIME_BUDGET_MS=
# Optional: after a target-meeting send, later digest cron ticks within this many hours
# no-op as already_sent (default 18) so the follow-up schedule doesn't re-email.
SALES_DIGEST_ALREADY_SENT_WINDOW_HOURS=
# Optional: max self-chained digest invocations after a deferred ensure (default 40).
# Each chain tick tops up toward 10×70; chaining stops early if the funnel is empty or
# a target-meeting digest already sent.
SALES_DIGEST_CONTINUE_MAX=

# Canonical public app URL used in emails, Open Graph, and share links.
# Production should be https://app.crowdsourcechoir.com — if unset, production
# still defaults to that (and will not use the raw *.vercel.app VERCEL_URL).
NEXT_PUBLIC_APP_URL=https://app.crowdsourcechoir.com

# Gmail 1:1 sales assistant — send-on-approve, reply sync, AI nudge drafts for human approval.
# Also run supabase/sales-platform-add-gmail.sql once in the Supabase SQL Editor.
# Create an OAuth client (Web application) in Google Cloud Console with redirect URI
#   {NEXT_PUBLIC_APP_URL}/api/sales/gmail/callback
# (and http://localhost:3000/api/sales/gmail/callback for local). Scopes: gmail.send, gmail.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if the redirect URI can't be derived from NEXT_PUBLIC_APP_URL / VERCEL_URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Long random secret used to encrypt the Gmail refresh token at rest (e.g. openssl rand -hex 32).
GMAIL_TOKEN_ENCRYPTION_KEY=

# Song Garden V2 (docs/song-garden-v2/). Optional: powers the "Generate with AI" button in the
# event admin's world storyboard section (uploads a venue/city/org photo + a vibe prompt, gets
# back a sequence of looping videos that animate the world from dormant -> full bloom).
# Create a key at https://dev.runwayml.com (Developer Portal -> API Keys). Note: Runway requires
# a minimum credit purchase before the key can generate anything — GET /v1/organization (used by
# the "Check Runway credits" button in the admin) works even before you've added credits.
RUNWAYML_API_SECRET=
# Optional: Supabase Storage bucket the generated storyboard videos are uploaded to (created
# automatically, as public, on first use). Falls back to writing files under
# public/song-garden-v2/world-scenes/generated/ when Supabase isn't configured (local dev).
SONG_GARDEN_MEDIA_BUCKET=song-garden-world-media
